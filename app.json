{
    "expo": {
        "name": "FotoApuntes",
        "slug": "react-camara",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "permissions": [
                "android.permission.CAMERA"
            ],
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/android-icon-foreground.png",
                "backgroundImage": "./assets/android-icon-background.png",
                "monochromeImage": "./assets/android-icon-monochrome.png"
            },
            "package": "com.adrian444.reactcamara",
            "googleServicesFile": "./google-services.json"
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "extra": {
            "eas": {
                "projectId": "6a9888cb-902b-458f-9fee-6bef79e5d600"
            }
        },
        "plugins": [
            [
                "expo-splash-screen",
                {
                    "image": "./assets/splash-icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#536DFE"
                }
            ],
            "@react-native-firebase/app",
            "@react-native-firebase/app-check",
            [
                "expo-build-properties",
                {
                    "ios": {
                        "useFrameworks": "dynamic"
                    }
                }
            ],
            [
                "expo-image-picker",
                {
                    "cameraPermission": "FotoApuntes usa la cámara para fotografiar tus apuntes.",
                    "photosPermission": "FotoApuntes necesita acceso a tus fotos para elegir un apunte de la galería.",
                    "microphonePermission": false
                }
            ],
            "expo-sqlite",
            "expo-status-bar",
            "expo-router"
        ],
        "scheme": "reactcamara"
    }
}
